@inherits LayoutComponentBase

<div class="d-flex flex-column flex-md-row min-vh-100">
    
    <!-- Sidebar -->
    <nav class="sidebar p-3 text-white flex-shrink-0 d-none d-md-block" style="width: 250px;">
        <div class="d-flex align-items-center mb-3 mb-md-0 me-md-auto text-white text-decoration-none">
            <span class="fs-4 fw-bold"><i class="bi bi-shop me-2"></i>Admin Panel</span>
        </div>
        <hr>
        <ul class="nav nav-pills flex-column mb-auto">
            <li class="nav-item">
                <NavLink class="nav-link text-white" href="" Match="NavLinkMatch.All">
                    <i class="bi bi-speedometer2 me-2"></i> Dashboard
                </NavLink>
            </li>
            <li>
                <NavLink class="nav-link text-white" href="modelos">
                    <i class="bi bi-box-seam me-2"></i> Catálogo e Inventario
                </NavLink>
            </li>
            <li>
                <NavLink class="nav-link text-white" href="reportes">
                    <i class="bi bi-bar-chart-line me-2"></i> Análisis Avanzado
                </NavLink>
            </li>
            <li>
                <NavLink class="nav-link text-white" href="usuarios">
                    <i class="bi bi-people me-2"></i> Usuarios
                </NavLink>
            </li>
        </ul>
    </nav>

    <!-- Mobile Header -->
    <header class="d-md-none bg-dark text-white p-3 d-flex justify-content-between align-items-center shadow-sm">
        <span class="fs-5 fw-bold"><i class="bi bi-shop me-2"></i>Admin Panel</span>
        <button class="btn btn-outline-light btn-sm" type="button" data-bs-toggle="offcanvas" data-bs-target="#mobileSidebar">
            <i class="bi bi-list fs-4"></i>
        </button>
    </header>

    <!-- Mobile Offcanvas Sidebar -->
    <div class="offcanvas offcanvas-start bg-dark text-white" tabindex="-1" id="mobileSidebar">
        <div class="offcanvas-header border-bottom border-secondary">
            <h5 class="offcanvas-title fw-bold"><i class="bi bi-shop me-2"></i>Admin Panel</h5>
            <button type="button" class="btn-close btn-close-white" data-bs-dismiss="offcanvas"></button>
        </div>
        <div class="offcanvas-body p-3 sidebar">
            <ul class="nav nav-pills flex-column mb-auto">
                <li class="nav-item">
                    <NavLink class="nav-link text-white" href="" Match="NavLinkMatch.All" onclick="document.querySelector('.btn-close').click()">
                        <i class="bi bi-speedometer2 me-2"></i> Dashboard
                    </NavLink>
                </li>
                <li>
                    <NavLink class="nav-link text-white" href="modelos" onclick="document.querySelector('.btn-close').click()">
                        <i class="bi bi-box-seam me-2"></i> Catálogo e Inventario
                    </NavLink>
                </li>
                <li>
                    <NavLink class="nav-link text-white" href="reportes" onclick="document.querySelector('.btn-close').click()">
                        <i class="bi bi-bar-chart-line me-2"></i> Análisis Avanzado
                    </NavLink>
                </li>
                <li>
                    <NavLink class="nav-link text-white" href="usuarios" onclick="document.querySelector('.btn-close').click()">
                        <i class="bi bi-people me-2"></i> Usuarios
                    </NavLink>
                </li>
            </ul>
        </div>
    </div>

    <!-- Main Content -->
    <main class="flex-grow-1 d-flex flex-column overflow-hidden">
        <!-- Top Bar -->
        <div class="top-header px-4 py-3 d-flex justify-content-end align-items-center">
            <AuthorizeView>
                <Authorized>
                    <div class="d-flex align-items-center">
                        <span class="me-3 fw-medium text-secondary">
                            <i class="bi bi-person-circle me-1"></i> @context.User.Identity?.Name
                        </span>
                        <form action="/api/auth/logout" method="post" class="m-0">
                            <AntiforgeryToken />
                            <button type="submit" class="btn btn-danger btn-sm rounded-pill px-3">
                                <i class="bi bi-box-arrow-right"></i> Salir
                            </button>
                        </form>
                    </div>
                </Authorized>
            </AuthorizeView>
        </div>

        <!-- Body -->
        <article class="flex-grow-1 p-3 p-md-4 overflow-auto">
            <div class="container-fluid max-w-1200 mx-auto">
                @Body
            </div>
        </article>
    </main>
</div>

