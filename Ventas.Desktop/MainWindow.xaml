<Window x:Class="Ventas.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        TextElement.Foreground="{DynamicResource MaterialDesignBody}"
        TextElement.FontWeight="Regular"
        TextElement.FontSize="13"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="Auto"
        Background="{DynamicResource MaterialDesignPaper}"
        FontFamily="{DynamicResource MaterialDesignFont}"
        Title="POS TÃ¡ctil - Mayorista" Height="800" Width="1280"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized"
        PreviewKeyDown="Window_PreviewKeyDown">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="80"/>
            <ColumnDefinition Width="3*"/>
            <ColumnDefinition Width="1.2*"/>
        </Grid.ColumnDefinitions>

        <!-- SIDEBAR IZQUIERDA -->
        <Border Grid.Column="0" Background="White" Effect="{DynamicResource MaterialDesignShadowDepth2}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                
                <StackPanel Grid.Row="0" Margin="0,20,0,0">
                    <Button Style="{StaticResource MaterialDesignFloatingActionMiniLightButton}" Background="Transparent" BorderBrush="Transparent" Margin="0,0,0,10" ToolTip="POS">
                        <materialDesign:PackIcon Kind="Storefront" Width="30" Height="30" Foreground="#673AB7"/>
                    </Button>
                </StackPanel>
                
                <StackPanel Grid.Row="1" VerticalAlignment="Top" Margin="0,20,0,0">
                    <Button Style="{StaticResource MaterialDesignIconButton}" ToolTip="Etiquetas Adhesivas" Height="60" Width="60" Click="btnMenuEtiquetas_Click">
                        <StackPanel>
                            <materialDesign:PackIcon Kind="Barcode" Width="24" Height="24" HorizontalAlignment="Center" Foreground="#9C27B0"/>
                            <TextBlock Text="Etiquetas" FontSize="10" HorizontalAlignment="Center" Margin="0,2,0,0" Foreground="#9C27B0"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource MaterialDesignIconButton}" ToolTip="Historial Ventas" Height="60" Width="60" Margin="0,15,0,0" Click="btnMenuVentas_Click">
                        <StackPanel>
                            <materialDesign:PackIcon Kind="ClipboardTextClock" Width="24" Height="24" HorizontalAlignment="Center" Foreground="#FF9800"/>
                            <TextBlock Text="Ventas" FontSize="10" HorizontalAlignment="Center" Margin="0,2,0,0" Foreground="#FF9800"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource MaterialDesignIconButton}" ToolTip="ConfiguraciÃ³n" Height="60" Width="60" Margin="0,15,0,0" Click="btnMenuConfig_Click">
                        <StackPanel>
                            <materialDesign:PackIcon Kind="Cog" Width="24" Height="24" HorizontalAlignment="Center" Foreground="#607D8B"/>
                            <TextBlock Text="Ajustes" FontSize="10" HorizontalAlignment="Center" Margin="0,2,0,0" Foreground="#607D8B"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource MaterialDesignIconButton}" ToolTip="Sincronizar" Height="60" Width="60" Margin="0,15,0,0" Click="btnSync_Click">
                        <StackPanel>
                            <materialDesign:PackIcon Kind="Sync" Width="24" Height="24" HorizontalAlignment="Center" Foreground="#2196F3"/>
                            <TextBlock Text="Sincronizar" FontSize="10" HorizontalAlignment="Center" Margin="0,2,0,0" Foreground="#2196F3"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource MaterialDesignIconButton}" ToolTip="Caja" Height="60" Width="60" Margin="0,15,0,0" Click="btnMenuCaja_Click">
                        <StackPanel>
                            <materialDesign:PackIcon Kind="CashRegister" Width="24" Height="24" HorizontalAlignment="Center" Foreground="#4CAF50"/>
                            <TextBlock Text="Caja" FontSize="10" HorizontalAlignment="Center" Margin="0,2,0,0" Foreground="#4CAF50"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
                
                <Button Grid.Row="2" Style="{StaticResource MaterialDesignIconButton}" ToolTip="Salir" Height="60" Width="60" Margin="0,0,0,20" Click="btnMenuSalir_Click">
                    <StackPanel>
                        <materialDesign:PackIcon Kind="Power" Width="24" Height="24" HorizontalAlignment="Center" Foreground="Red"/>
                        <TextBlock Text="Salir" FontSize="10" HorizontalAlignment="Center" Foreground="Red" Margin="0,2,0,0"/>
                    </StackPanel>
                </Button>
            </Grid>
        </Border>

        <!-- PANEL CENTRAL: CATÃƒÂLOGO -->
        <Grid Grid.Column="1" Background="#F4F6F8">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Buscador Superior -->
            <Border Grid.Row="0" Background="White" CornerRadius="25" Margin="20,20,20,10" Padding="15,5" 
                    Effect="{DynamicResource MaterialDesignShadowDepth1}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <materialDesign:PackIcon Kind="Magnify" Width="24" Height="24" Foreground="Gray" VerticalAlignment="Center"/>
                    <TextBox x:Name="txtBuscadorCodigo" Grid.Column="1" Margin="10,0,0,0" 
                             materialDesign:HintAssist.Hint="Buscar producto o escanear cÃ³digo de barras..." 
                             BorderThickness="0" FontSize="18" VerticalAlignment="Center"
                             KeyDown="txtBuscadorCodigo_KeyDown" TextChanged="txtBuscadorCodigo_TextChanged"/>
                </Grid>
            </Border>

            <!-- CategorÃƒÂ­as (PÃƒÂ­ldoras) -->
            <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" Margin="20,0,20,10">
                <StackPanel Orientation="Horizontal">
                    <Button Content="TODO" Style="{StaticResource MaterialDesignRaisedDarkButton}" materialDesign:ButtonAssist.CornerRadius="15" Margin="0,0,10,0" Click="btnCategoriaTodo_Click"/>
                    <ItemsControl x:Name="icCategorias">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Content="{Binding Nombre}" Style="{StaticResource MaterialDesignRaisedButton}" Background="#2196F3" BorderBrush="#2196F3" materialDesign:ButtonAssist.CornerRadius="15" Margin="0,0,10,0" Click="btnCategoria_Click" Tag="{Binding Id}"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>

            <!-- Grilla de Productos (Tarjetas) -->
            <ScrollViewer Grid.Row="2" Margin="20,10,20,20">
                <ItemsControl x:Name="icCatalogo">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                                                        <materialDesign:Card Width="180" Margin="0,0,15,15" materialDesign:ElevationAssist.Elevation="Dp1" UniformCornerRadius="10">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="250"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    
                                    <!-- Foto Placeholder Background -->
                                    <Border Grid.Row="0" Background="#EEEEEE" CornerRadius="10,10,0,0"/>
                                    <materialDesign:PackIcon Grid.Row="0" Kind="Image" Width="48" Height="48" Foreground="#BDBDBD" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    
                                    <!-- Foto Real -->
                                    <Border Grid.Row="0" CornerRadius="10,10,0,0" ClipToBounds="True">
                                        <Image Source="{Binding ImagePath}" Stretch="UniformToFill" />
                                    </Border>
                                    
                                    <!-- Stock Badge -->
                                    <Border Grid.Row="0" Background="White" CornerRadius="5" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="10" Padding="6,3">
                                        <TextBlock Text="{Binding StockFmt}" Foreground="{Binding StockColor}" FontWeight="Bold" FontSize="11"/>
                                    </Border>

                                    <!-- Datos Producto -->
                                    <StackPanel Grid.Row="1" Margin="10">
                                        <TextBlock Text="{Binding Nombre}" FontWeight="SemiBold" TextWrapping="Wrap" MaxHeight="40" FontSize="12"/>
                                        <TextBlock Text="{Binding Talla}" Foreground="Gray" FontSize="11" Margin="0,2,0,5"/>
                                        <Grid Margin="0,5,0,0">
                                            <TextBlock Text="{Binding PrecioFmt}" FontWeight="Bold" FontSize="16" Foreground="#3F51B5" VerticalAlignment="Center"/>
                                            <Button Style="{StaticResource MaterialDesignFloatingActionMiniButton}" Width="30" Height="30" HorizontalAlignment="Right" Background="#673AB7" BorderBrush="#673AB7"
                                                    Click="btnAgregarCard_Click" Tag="{Binding ModeloId}" IsEnabled="{Binding TieneStock}">
                                                <materialDesign:PackIcon Kind="Plus" Width="20" Height="20"/>
                                            </Button>
                                        </Grid>
                                    </StackPanel>
                                </Grid>
                            </materialDesign:Card>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>

        <!-- PANEL DERECHO: CARRITO -->
        <Grid Grid.Column="2" Background="White">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- TÃƒÂ­tulo y Limpiar -->
            <Grid Grid.Row="0" Margin="15">
                <TextBlock Text="NOTA DE VENTA" FontSize="18" FontWeight="Bold" VerticalAlignment="Center"/>
                <Button Content="LIMPIAR" Style="{StaticResource MaterialDesignOutlinedButton}" Foreground="Red" BorderBrush="Red" HorizontalAlignment="Right" Click="btnLimpiar_Click"/>
            </Grid>

            <!-- Lista de Carrito -->
                                    <DataGrid x:Name="dgVentaActual" Grid.Row="1" AutoGenerateColumns="False" CanUserAddRows="False" 
                      BorderThickness="0" Background="White" HeadersVisibility="Column" Margin="10,0">
                <DataGrid.Columns>
                    <DataGridTemplateColumn Header="Prod" Width="*">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel VerticalAlignment="Center" Margin="5,2" >
                                    <TextBlock Text="{Binding Nombre}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                                        <Button Style="{DynamicResource MaterialDesignToolButton}" Height="25" Width="25" Click="btnRestarCarrito_Click" Tag="{Binding ModeloId}" Padding="0">
                                            <materialDesign:PackIcon Kind="Minus" Width="15" Height="15" Foreground="#D32F2F"/>
                                        </Button>
                                        <TextBox Text="{Binding CantidadDocenas, UpdateSourceTrigger=PropertyChanged}" 
                                                 FontSize="15" FontWeight="Black" Foreground="#1565C0" 
                                                 VerticalAlignment="Center" Margin="10,0" Width="40" 
                                                 TextAlignment="Center"
                                                 materialDesign:TextFieldAssist.DecorationVisibility="Hidden"
                                                 BorderThickness="0,0,0,1" BorderBrush="Gray"
                                                 PreviewTextInput="TxtCantidad_PreviewTextInput"
                                                 TextChanged="TxtCantidad_TextChanged"
                                                 LostFocus="TxtCantidad_LostFocus"
                                                 Tag="{Binding ModeloId}"/>
                                        <Button Style="{DynamicResource MaterialDesignToolButton}" Height="25" Width="25" Click="btnSumarCarrito_Click" Tag="{Binding ModeloId}" Padding="0">
                                            <materialDesign:PackIcon Kind="Plus" Width="15" Height="15" Foreground="#2E7D32"/>
                                        </Button>
                                    </StackPanel>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="Total" Binding="{Binding Total, StringFormat=N2}" Width="70">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="HorizontalAlignment" Value="Right"/>
                                <Setter Property="VerticalAlignment" Value="Center"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTemplateColumn Width="70">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Button Style="{StaticResource MaterialDesignIconButton}" ToolTip="Quitar" 
                                        Height="35" Width="35" Padding="0" Margin="0,0,10,0" Click="btnQuitarCarrito_Click" Tag="{Binding ModeloId}">
                                    <materialDesign:PackIcon Kind="TrashCan" Foreground="#D32F2F" Width="22" Height="22" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Button>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>

            <!-- Total y Botones -->
            <StackPanel Grid.Row="2" Margin="15">
                <Grid Margin="0,0,0,15">
                    <TextBlock Text="TOTAL" FontSize="20" FontWeight="Bold" VerticalAlignment="Center"/>
                    <TextBlock x:Name="txtTotal" Text="S/ 0.00" FontSize="32" FontWeight="Black" Foreground="#2E7D32" HorizontalAlignment="Right"/>
                </Grid>

                <Button Content="COBRAR" Height="60" FontSize="18" FontWeight="Bold" Background="#28A745" BorderBrush="#28A745" Style="{StaticResource MaterialDesignRaisedButton}" Click="btnCobrar_Click"/>
            </StackPanel>
        </Grid>
        
        <!-- Toast Notification -->
        <materialDesign:Snackbar x:Name="MainSnackbar" MessageQueue="{materialDesign:MessageQueue}" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="20"/>
    </Grid>
</Window>











