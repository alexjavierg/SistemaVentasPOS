<Window x:Class="Ventas.Desktop.ConfiguracionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        TextElement.Foreground="{DynamicResource MaterialDesignBody}"
        TextElement.FontWeight="Regular"
        TextElement.FontSize="14"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="Auto"
        Background="{DynamicResource MaterialDesignPaper}"
        FontFamily="{DynamicResource MaterialDesignFont}"
        Title="ConfiguraciÃ³n Local de Caja" Height="700" Width="600"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="CONFIGURACIÃ“N" FontSize="20" FontWeight="Bold" Margin="0,0,0,20"/>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="0,0,10,0">
                
                <TextBlock Text="Opciones Generales" FontWeight="Bold" Foreground="#673AB7" Margin="0,0,0,10"/>
                <CheckBox x:Name="chkAutoImprimir" Content="Imprimir Nota de Venta AutomÃ¡ticamente" Margin="0,0,0,20"/>

                <Separator Margin="0,10,0,20"/>

                <TextBlock Text="Impresoras" FontWeight="Bold" Foreground="#673AB7" Margin="0,0,0,10"/>
                
                <TextBlock Text="Impresora de Tickets (TÃ©rmica 80mm)" FontWeight="SemiBold" Margin="0,0,0,5"/>
                <ComboBox x:Name="cmbImpresora" materialDesign:HintAssist.Hint="Seleccione impresora de tickets" Style="{StaticResource MaterialDesignFloatingHintComboBox}" Margin="0,0,0,15"/>

                <TextBlock Text="Impresora de Etiquetas (TSPL 98x20)" FontWeight="SemiBold" Margin="0,0,0,5"/>
                <ComboBox x:Name="cmbImpresoraEtiquetas" materialDesign:HintAssist.Hint="Seleccione impresora de etiquetas" Style="{StaticResource MaterialDesignFloatingHintComboBox}" Margin="0,0,0,20"/>

                <Separator Margin="0,10,0,20"/>

                <TextBlock Text="Logotipos" FontWeight="Bold" Foreground="#673AB7" Margin="0,0,0,10"/>
                
                <!-- Logo Ticket -->
                <TextBlock Text="Logo Corporativo (Ticket)" FontWeight="SemiBold" Margin="0,0,0,5"/>
                <Grid Margin="0,0,0,15">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="txtLogoStatus" Text="Sin logo seleccionado" Foreground="Gray" VerticalAlignment="Center"/>
                    <Button Grid.Column="1" Content="EXAMINAR" Style="{StaticResource MaterialDesignOutlinedButton}" Click="BtnSubirLogo_Click"/>
                </Grid>

                <Separator Margin="0,10,0,20"/>

                <TextBlock Text="CalibraciÃ³n TSPL" FontWeight="Bold" Margin="0,0,0,15" Foreground="#673AB7"/>
                <Grid Margin="0,0,0,15">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="50"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Offset X" VerticalAlignment="Center"/>
                    <Slider x:Name="sliderX" Grid.Column="0" Minimum="-50" Maximum="50" Value="0" TickFrequency="1" IsSnapToTickEnabled="True" Margin="80,0,10,0"/>
                    <TextBlock Grid.Column="1" Text="{Binding ElementName=sliderX, Path=Value}" VerticalAlignment="Center" HorizontalAlignment="Right" FontWeight="Bold"/>
                </Grid>
                <Grid Margin="0,0,0,15">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="50"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Offset Y" VerticalAlignment="Center"/>
                    <Slider x:Name="sliderY" Grid.Column="0" Minimum="-50" Maximum="50" Value="0" TickFrequency="1" IsSnapToTickEnabled="True" Margin="80,0,10,0"/>
                    <TextBlock Grid.Column="1" Text="{Binding ElementName=sliderY, Path=Value}" VerticalAlignment="Center" HorizontalAlignment="Right" FontWeight="Bold"/>
                </Grid>
                <Grid Margin="0,0,0,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="50"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="SeparaciÃ³n (mm)" Foreground="#D81B60" VerticalAlignment="Center"/>
                    <Slider x:Name="sliderSeparacion" Grid.Column="0" Minimum="0" Maximum="10" Value="3" TickFrequency="1" IsSnapToTickEnabled="True" Margin="110,0,10,0"/>
                    <TextBlock Grid.Column="1" Text="{Binding ElementName=sliderSeparacion, Path=Value, StringFormat={}{0} mm}" VerticalAlignment="Center" HorizontalAlignment="Right" FontWeight="Bold" Foreground="#D81B60"/>
                </Grid>

                <Separator Margin="0,10,0,20"/>
                
                <TextBlock Text="Sucursal Activa" FontWeight="Bold" Foreground="#673AB7" Margin="0,0,0,5"/>
                <TextBox x:Name="txtIdSucursal" materialDesign:HintAssist.Hint="ID Sucursal (Ej. 1)" Style="{StaticResource MaterialDesignFloatingHintTextBox}" Margin="0,0,0,20"/>

                
            </StackPanel>
        </ScrollViewer>

        <Grid Grid.Row="2" Margin="0,20,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Button Grid.Column="1" Content="CANCELAR" Style="{StaticResource MaterialDesignFlatButton}" Margin="0,0,10,0" Click="BtnCancelar_Click"/>
            <Button Grid.Column="2" Content="GUARDAR CAMBIOS" Style="{StaticResource MaterialDesignRaisedButton}" Height="40" Click="BtnGuardar_Click"/>
        </Grid>
    </Grid>
</Window>



