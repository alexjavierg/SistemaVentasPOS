<Window x:Class="Ventas.Desktop.EtiquetasWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="Impresión Masiva de Etiquetas" 
        Height="700" Width="1100" 
        WindowStartupLocation="CenterScreen" 
        WindowState="Maximized" 
        Background="#F0F2F5">

    <Grid Margin="10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="450"/>
        </Grid.ColumnDefinitions>

        <DockPanel Grid.Column="0" Margin="0,0,10,0">
            <materialDesign:Card DockPanel.Dock="Top" Margin="0,0,0,10" Padding="5" UniformCornerRadius="5">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <materialDesign:PackIcon Kind="Magnify" Width="30" Height="30" VerticalAlignment="Center" Margin="5"/>
                    <TextBox x:Name="txtBusqueda" Grid.Column="1" 
                             materialDesign:HintAssist.Hint="Buscar producto por nombre..." 
                             FontSize="16" BorderThickness="0" Height="40" Padding="5"
                             materialDesign:TextFieldAssist.DecorationVisibility="Hidden"/>
                </Grid>
            </materialDesign:Card>

            <ScrollViewer VerticalScrollBarVisibility="Auto" PanningMode="VerticalOnly">
                <ItemsControl x:Name="icCategoriasExpander">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Expander Background="White" Margin="0,2,0,10" BorderBrush="#673AB7" BorderThickness="0,0,0,2" HorizontalContentAlignment="Stretch" IsExpanded="False">
                                <Expander.Header>
                                    <TextBlock Text="{Binding Nombre}" FontSize="18" FontWeight="Black" Foreground="#673AB7" VerticalAlignment="Center"/>
                                </Expander.Header>

                                <Expander.Content>
                                    <ItemsControl ItemsSource="{Binding Modelos}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border BorderBrush="#EEE" BorderThickness="0,0,0,1" Padding="10" Background="#FAFAFA" Margin="10,2">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>

                                                        <StackPanel VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding Nombre}" FontWeight="Bold" FontSize="15"/>
                                                            <TextBlock Text="ESTÁNDAR" FontSize="12" Foreground="Gray"/>
                                                            <TextBlock FontSize="12" Foreground="#673AB7" Margin="0,2,0,0">
                                                                <Run Text="Precio: "/>
                                                                <Run Text="{Binding PrecioPorDocena, StringFormat=S/ {0:N2}}"/>
                                                                <Run Text=" | Pendientes: "/>
                                                                <Run Text="{Binding EtiquetasPendientes}" FontWeight="Bold" Foreground="#FF9800"/>
                                                            </TextBlock>
                                                        </StackPanel>

                                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                            <Button Content="⚡ PENDIENTES" ToolTip="Agregar solo pendientes" Height="35" Margin="5,0" 
                                                                    Style="{StaticResource MaterialDesignOutlinedButton}" Foreground="#FF9800" BorderBrush="#FF9800"
                                                                    Click="BtnAnadirPendientes_Click" Tag="{Binding}"/>
                                                            <Button Content="+ 1" ToolTip="Añadir una impresión" Height="35" Width="60" Margin="5,0"
                                                                    Style="{StaticResource MaterialDesignFlatButton}" Background="#E0E0E0" 
                                                                    Click="BtnAnadirAlCarrito_Click" Tag="{Binding}"/>
                                                        </StackPanel>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </Expander.Content>
                            </Expander>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </DockPanel>

        <materialDesign:Card Grid.Column="1" materialDesign:ElevationAssist.Elevation="Dp4" UniformCornerRadius="10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Border Background="#673AB7" Padding="15" CornerRadius="10,10,0,0">
                    <TextBlock Text="COLA DE IMPRESIÓN" Foreground="White" FontWeight="Bold" FontSize="18" HorizontalAlignment="Center"/>
                </Border>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" PanningMode="VerticalOnly">
                    <DataGrid x:Name="dgCarrito" AutoGenerateColumns="False" CanUserAddRows="False" SelectionMode="Single" 
                              Background="White" BorderThickness="0" RowHeight="75" FontSize="14" GridLinesVisibility="Horizontal">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="Producto" Width="*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="5" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding NombreModelo}" FontWeight="Bold" Foreground="Black" FontSize="14" TextWrapping="Wrap"/>
                                            <TextBlock Text="{Binding Talla}" FontSize="12" Foreground="Gray" Margin="0,2,0,0"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTemplateColumn Header="Cant" Width="90">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBox Text="{Binding CantidadAImprimir, UpdateSourceTrigger=PropertyChanged}" 
                                                 TextAlignment="Center" FontWeight="Bold" FontSize="20" Height="50"
                                                 VerticalAlignment="Center" Background="#F5F5F5" Padding="0,10,0,0" TextChanged="TextBoxCantidad_TextChanged"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTemplateColumn Width="75">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Style="{StaticResource MaterialDesignIconButton}" Foreground="Red" 
                                                Click="BtnEliminarItem_Click" Width="50" Height="50" HorizontalAlignment="Center">
                                            <materialDesign:PackIcon Kind="CloseCircle" Width="30" Height="30"/>
                                        </Button>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </ScrollViewer>

                <StackPanel Grid.Row="2" Background="#FAFAFA">
                    <Border BorderBrush="#EEE" BorderThickness="0,1,0,0" Padding="10">
                        <TextBlock x:Name="txtResumenEtiquetas" Text="0 Modelos | 0 Etiquetas en total" 
                                   TextAlignment="Center" FontWeight="Bold" FontSize="15" Foreground="#333"/>
                    </Border>

                    <Grid Margin="10,0,10,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Content="LIMPIAR" Style="{StaticResource MaterialDesignOutlinedButton}" 
                                Foreground="Red" BorderBrush="Red" Margin="0,0,10,0" Height="50" Width="100"
                                Click="BtnLimpiarCarrito_Click"/>
                        <Button Grid.Column="1" x:Name="btnImprimirTodo" Height="50" 
                                Content="IMPRIMIR ETIQUETAS" FontSize="16" FontWeight="Black"
                                Style="{StaticResource MaterialDesignRaisedButton}" 
                                Background="#673AB7" BorderBrush="#673AB7"
                                Click="BtnImprimirTodo_Click"/>
                    </Grid>
                </StackPanel>
            </Grid>
        </materialDesign:Card>
    </Grid>
</Window>
